{
  "name": "@chatlychat/sdk-node",
  "version": "0.1.0",
  "description": "Server-side SDK for the LiveChat platform — REST client + webhook signature verification.",
  "license": "MIT",
  "homepage": "https://chatlychat.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatlychat/chatly-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/chatlychat/chatly-sdk-node/issues"
  },
  "keywords": [
    "livechat",
    "chat",
    "messaging",
    "support",
    "webhooks",
    "sdk",
    "server"
  ],
  "author": "LiveChat Platform Engineering",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
